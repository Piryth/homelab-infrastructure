services:
  caddy:
    build: .
    ports:
      - "80:80"
      - "443:443"
    container_name: caddy
    restart: unless-stopped
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - ./caddy_data:/data
      - ./caddy_config:/config
    environment:
      - CLOUDFLARE_API_TOKEN={{ caddy_cloudflare_token }}
{% if caddy_tracing | bool %}
      # OTLP/gRPC to Tempo on caddy_network (http:// = no TLS inside the Docker network)
      - OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4317
      - OTEL_SERVICE_NAME=caddy
      - OTEL_TRACES_SAMPLER=parentbased_traceidratio
      - OTEL_TRACES_SAMPLER_ARG={{ caddy_tracing_sample_ratio }}
{% endif %}
    networks:
      - proxy

networks:
  proxy:
    name: caddy_network
    driver: bridge
