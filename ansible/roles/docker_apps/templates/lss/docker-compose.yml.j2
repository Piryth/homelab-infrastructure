x-environment:
  PUID: 1000
  PGID: 1000
  TZ: Europe/Paris
services:

  gluetun:
    image: qmcgaw/gluetun
    container_name: gluetun
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      - VPN_SERVICE_PROVIDER=protonvpn
      - VPN_TYPE=wireguard
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY}
      - SERVER_COUNTRIES=France
    sysctls:
      - net.ipv4.ip_forward=1
      - net.ipv6.conf.all.forwarding=1
    restart: unless-stopped
    networks:
      lss_network: null
    ports:
      - '9090:9090'
      - '6881:6881'
      - '6881:6881/udp'
    volumes:
      - '/data/config/gluetun:/gluetun'
    healthcheck:
      test:
        - CMD
        - wget
        - '-q'
        - '--spider'
        - 'http://ipinfo.io'
      interval: 30s
      start_period: 30s
      timeout: 10s
      retries: 3

  qbittorrent:
    image: 'lscr.io/linuxserver/qbittorrent:latest'
    container_name: qbittorrent
    network_mode: 'service:gluetun'
    environment:
      TZ: France/Paris
      WEBUI_PORT: 9090
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/qbittorrent:/config'
      - '/mnt/pool/data/torrents:/data/torrents'
    depends_on:
      gluetun:
        condition: service_healthy
    restart: unless-stopped
    env_file:
      - .env
  prowlarr:
    image: 'lscr.io/linuxserver/prowlarr:latest'
    container_name: prowlarr
    networks:
      lss_network: null
    ports:
      - '9696:9696'
    environment:
      TZ: France/Paris
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/prowlarr:/config'
    restart: unless-stopped
    env_file:
      - .env
  flaresolverr:
    image: 'ghcr.io/flaresolverr/flaresolverr:latest'
    container_name: flaresolverr
    networks:
      lss_network: null
    ports:
      - '8191:8191'
    environment:
      LOG_LEVEL: info
      TZ: France/Paris
      PUID: 1000
      PGID: 1000
    restart: unless-stopped
    env_file:
      - .env
  radarr:
    image: 'lscr.io/linuxserver/radarr:latest'
    container_name: radarr
    networks:
      lss_network: null
    ports:
      - '7878:7878'
    environment:
      TZ: France/Paris
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/radarr:/config'
      - '/mnt/pool/data:/data'
    restart: unless-stopped
    env_file:
      - .env
  sonarr:
    image: 'lscr.io/linuxserver/sonarr:latest'
    container_name: sonarr
    networks:
      lss_network: null
    ports:
      - '8989:8989'
    environment:
      TZ: France/Paris
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/sonarr:/config'
      - '/mnt/pool/data:/data'
    restart: unless-stopped
    env_file:
      - .env
  lidarr:
    image: 'lscr.io/linuxserver/lidarr:latest'
    container_name: lidarr
    ports:
      - '8686:8686'
    volumes:
      - '/data/config/lidarr:/config'
      - '/mnt/pool/data:/data'
    restart: unless-stopped
    environment:
      PUID: 1000
      PGID: 1000
    networks:
      lss_network: null
    env_file:
      - .env
  jellyfin:
    image: 'jellyfin/jellyfin:latest'
    container_name: jellyfin
    ports:
      - '8096:8096'
    networks:
      lss_network: null
    environment:
      TZ: Europe/Paris
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/jellyfin:/config'
      - '/data/config/jellyfin/cache:/cache'
      - '/mnt/pool/data/media:/media:ro'
    restart: unless-stopped
    env_file:
      - .env
  jellyseerr:
    image: 'fallenbagel/jellyseerr:latest'
    container_name: jellyseerr
    ports:
      - '5055:5055'
    networks:
      lss_network: null
    environment:
      TZ: Europe/Paris
      PUID: 1000
      PGID: 1000
    volumes:
      - '/data/config/jellyseerr:/app/config'
    restart: unless-stopped
    env_file:
      - .env
  recyclarr:
    image: ghcr.io/recyclarr/recyclarr
    container_name: recyclarr
    networks:
      lss_network: null
    volumes:
      - '/data/config/recyclarr:/config'
    environment:
      TZ: Europe/Paris
    restart: unless-stopped
    env_file:
      - .env
  navidrome:
    image: deluan/navidrome:latest
    user: 1000:1000
    ports:
      - "4533:4533"
    restart: unless-stopped
    volumes:
      - "/data/config/navidrome:/data"
      - "/mnt/pool/data/media/music:/music:ro"
    networks:
      lss_network: null
networks:
  lss_network:
    driver: bridge