{# templates/nextcloud/docker-compose.yml.j2 #}
services:
  nextcloud-db:
    image: mariadb:11
    container_name: nextcloud-db
    restart: unless-stopped
    command: --transaction-isolation=READ-COMMITTED --log-bin=binlog --binlog-format=ROW
    volumes:
      - nextcloud-db:/var/lib/mysql
    environment:
      MYSQL_ROOT_PASSWORD: "{{ '{{ MYSQL_ROOT_PASSWORD }}' }}"
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: "{{ '{{ MYSQL_PASSWORD }}' }}"
    networks:
      - nextcloud-internal
    env_file:
      - .env

  nextcloud-redis:
    image: redis:alpine
    container_name: nextcloud-redis
    restart: unless-stopped
    networks:
      - nextcloud-internal

  nextcloud-app:
    image: nextcloud:stable
    container_name: nextcloud-app
    restart: unless-stopped
    volumes:
      - nextcloud-data:/var/www/html
    dns:
      - 192.168.1.232
    environment:
      MYSQL_HOST: nextcloud-db
      MYSQL_DATABASE: nextcloud
      MYSQL_USER: nextcloud
      MYSQL_PASSWORD: "{{ '{{ MYSQL_PASSWORD }}' }}"
      REDIS_HOST: nextcloud-redis
      NEXTCLOUD_ADMIN_USER: "{{ '{{ NEXTCLOUD_ADMIN_USER }}' }}"
      NEXTCLOUD_ADMIN_PASSWORD: "{{ '{{ NEXTCLOUD_ADMIN_PASSWORD }}' }}"
      NEXTCLOUD_TRUSTED_DOMAINS: "{{ nextcloud_domain }}"
      TRUSTED_PROXIES: 172.16.0.0/12
      OVERWRITEPROTOCOL: https
      OVERWRITECLIURL: "https://{{ nextcloud_domain }}"
      # Mail — via Proton Mail Bridge
      MAIL_FROM_ADDRESS: "{{ '{{ SMTP_FROM }}' }}"
      MAIL_DOMAIN: "{{ nextcloud_mail_domain }}"
      SMTP_HOST: protonmail-bridge
      SMTP_PORT: "1025"
      SMTP_SECURE: ""
      SMTP_AUTHTYPE: LOGIN
      SMTP_NAME: "{{ '{{ SMTP_NAME }}' }}"
      SMTP_PASSWORD: "{{ '{{ SMTP_PASSWORD }}' }}"

    networks:
      nextcloud-internal:
        aliases:
          - "{{ nextcloud_domain }}"
      caddy-proxy:
        aliases:
          - "{{ nextcloud_domain }}"
    depends_on:
      - nextcloud-db
      - nextcloud-redis
      - protonmail-bridge
    env_file:
      - .env
    
  onlyoffice-document-server:
    container_name: onlyoffice-document-server
    image: onlyoffice/documentserver:latest
    restart: always
    dns:
      - 192.168.1.232
    environment:
      - JWT_SECRET={{ onlyoffice_secret }}
      - JWT_ENABLED=true
      - JWT_HEADER=AuthorizationJwt
      - USE_UNAUTHORIZED_STORAGE=true 
    volumes:
      - document_data:/var/www/onlyoffice/Data
      - document_log:/var/log/onlyoffice
    networks:
      - nextcloud-internal
      - caddy-proxy

  nextcloud-cron:
    image: nextcloud:stable
    container_name: nextcloud-cron
    restart: unless-stopped
    volumes:
      - nextcloud-data:/var/www/html
    entrypoint: /cron.sh
    depends_on:
      - nextcloud-db
      - nextcloud-redis
    networks:
      - nextcloud-internal

  protonmail-bridge:
    image: shenxn/protonmail-bridge:latest
    container_name: protonmail-bridge
    restart: unless-stopped
    volumes:
      - protonmail-bridge-data:/root
    networks:
      - nextcloud-internal

volumes:
  nextcloud-db:
  nextcloud-data:
  protonmail-bridge-data:
  document_data:
  document_log:

networks:
  nextcloud-internal:
    internal: true
  caddy-proxy:
    name: caddy_network
    external: true
