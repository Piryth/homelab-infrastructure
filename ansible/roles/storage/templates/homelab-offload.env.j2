# Managed by Ansible — do not edit manually
QB_URL={{ storage_qbittorrent_url }}
QB_USER={{ storage_qbittorrent_user }}
QB_PASS="{{ storage_qbittorrent_password | replace('\\', '\\\\') | replace('"', '\\"') }}"
RCLONE_CONFIG={{ storage_rclone_config }}
OFFLOAD_DRY_RUN={{ storage_offload_dry_run | bool | lower }}
OFFLOAD_LOCAL_ROOT={{ storage_local_dir }}
OFFLOAD_CONTAINER_ROOT={{ storage_offload_container_root }}
OFFLOAD_LIBRARY={{ storage_local_dir }}/media
OFFLOAD_POOL_LIBRARY={{ mergerfs_pool_path }}/media
OFFLOAD_REMOTE={{ storage_crypt_name }}:media
OFFLOAD_RC_ADDR={{ storage_rclone_rc_addr }}
OFFLOAD_RC_PREFIX=media
OFFLOAD_STATE={{ storage_offload_state_dir }}/state.json
OFFLOAD_CATEGORIES={{ storage_offload_categories.items() | map('join', ':') | join(',') }}
OFFLOAD_LOW_GB={{ storage_offload_low_gb }}
OFFLOAD_HIGH_GB={{ storage_offload_high_gb }}
OFFLOAD_MIN_RATIO={{ storage_offload_min_ratio }}
OFFLOAD_MIN_SEED_H={{ storage_offload_min_seed_hours }}
OFFLOAD_HARD_MIN_SEED_H={{ storage_offload_hard_min_seed_hours }}
OFFLOAD_MAX_SEED_DAYS={{ storage_offload_max_seed_days }}
OFFLOAD_MAX_SEED_POPULAR_DAYS={{ storage_offload_max_seed_popular_days }}
OFFLOAD_SEED_WHILE_SPACE={{ storage_offload_seed_while_space | bool | lower }}
OFFLOAD_ORPHANS_ALWAYS={{ storage_offload_orphans_always | bool | lower }}
OFFLOAD_ORPHAN_MIN_AGE_H={{ storage_offload_orphan_min_age_hours }}
OFFLOAD_POP_WINDOW_DAYS={{ storage_offload_pop_window_days }}
OFFLOAD_POP_MIN_HISTORY_H={{ storage_offload_pop_min_history_hours }}
OFFLOAD_POP_FACTOR={{ storage_offload_pop_factor }}
OFFLOAD_POP_LEECHERS={{ storage_offload_pop_leechers }}
OFFLOAD_RARE_SEEDERS={{ storage_offload_rare_seeders }}
OFFLOAD_COLD_FACTOR={{ storage_offload_cold_factor }}
OFFLOAD_KEEP_TAG={{ storage_offload_keep_tag }}
OFFLOAD_MAX_GB_PER_RUN={{ storage_offload_max_gb_per_run }}
OFFLOAD_VERIFY={{ storage_offload_verify }}
OFFLOAD_TRANSFERS={{ storage_offload_transfers }}
OFFLOAD_METRICS_FILE={{ storage_offload_metrics_file }}
