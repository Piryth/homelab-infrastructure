# Copy this to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit secrets.

# -----------------------------------------------------------------------------
# Proxmox connection
# -----------------------------------------------------------------------------
pve_api_url   = "https://192.168.1.10:8006"
pve_api_token = "terraform@pam!terraform=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
pve_insecure  = true
pve_ssh_user  = "root"

# -----------------------------------------------------------------------------
# PVE nodes
# -----------------------------------------------------------------------------
pve_nodes = {
  pve1 = "192.168.1.10"
  pve2 = "192.168.1.11"
}

# -----------------------------------------------------------------------------
# SSH keys (paste your public key)
# -----------------------------------------------------------------------------
ssh_public_keys = [
  "ssh-ed25519 AAAA... user@workstation"
]


# -----------------------------------------------------------------------------
# LXC02 - Docker host
# -----------------------------------------------------------------------------
lxc01_vmid      = 101
lxc01_node      = "pve2"
lxc01_ip        = "192.168.1.30"
lxc01_hostname  = "docker"
lxc01_cores     = 2
lxc01_memory    = 2048
lxc01_swap      = 512
lxc01_disk_size = 32
lxc01_storage   = "local-lvm"
lxc01_template  = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"

# -----------------------------------------------------------------------------
# LXC02 - DNS host
# -----------------------------------------------------------------------------
lxc02_vmid      = 100
lxc02_node      = "pve1"
lxc02_ip        = "192.168.1.20"
lxc02_hostname  = "pihole"
lxc02_cores     = 1
lxc02_memory    = 512
lxc02_swap      = 256
lxc02_disk_size = 8
lxc02_storage   = "local-lvm"
lxc02_template  = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"
